<%# Renders one task as a row. Used by tasks/index. %>
<div class="list-group-item py-3">
  <div class="d-flex justify-content-between align-items-start flex-wrap gap-2">
    <div class="me-3">
      <div class="d-flex align-items-center gap-2 mb-1">
        <%= link_to task.title, task,
              class: "h6 mb-0 text-decoration-none #{'text-decoration-line-through text-body-secondary' if task.completed?}" %>
        <span class="badge <%= task.completed? ? 'text-bg-success' : 'text-bg-warning' %>">
          <%= task.status_label %>
        </span>
      </div>

      <% if task.description.present? %>
        <p class="mb-1 text-body-secondary small">
          <%= truncate(task.description, length: 120) %>
        </p>
      <% end %>

      <div class="small text-body-secondary">
        Created <%= task.created_at.strftime("%d %b %Y") %>
      </div>
    </div>

    <div class="d-flex gap-2 align-items-center">
      <%= button_to (task.completed? ? "Undo" : "Complete"),
            toggle_task_path(task),
            method: :patch,
            class: "btn btn-sm #{task.completed? ? 'btn-outline-secondary' : 'btn-success'}" %>

      <%= link_to "Edit", edit_task_path(task), class: "btn btn-sm btn-outline-primary" %>

      <%= button_to "Delete", task,
            method: :delete,
            class: "btn btn-sm btn-outline-danger",
            form: { data: { turbo_confirm: "Delete this task?" } } %>
    </div>
  </div>
</div>
