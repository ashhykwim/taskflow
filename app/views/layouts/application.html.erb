<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "TaskFlow" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <link rel="icon" href="/icon.png" type="image/png">

    <%# Bootstrap 5, vendored locally in app/assets so the app works offline
        and is not blocked by browser shields/ad-blockers. %>
    <%= stylesheet_link_tag "bootstrap.min" %>

    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="bg-body-tertiary">
    <%# ---------- Navbar ---------- %>
    <nav class="navbar navbar-expand-lg navbar-dark bg-dark shadow-sm">
      <div class="container">
        <%= link_to "TaskFlow", root_path, class: "navbar-brand fw-bold" %>

        <button class="navbar-toggler" type="button" data-bs-toggle="collapse"
                data-bs-target="#navbarMain" aria-controls="navbarMain"
                aria-expanded="false" aria-label="Toggle navigation">
          <span class="navbar-toggler-icon"></span>
        </button>

        <div class="collapse navbar-collapse" id="navbarMain">
          <ul class="navbar-nav me-auto">
            <li class="nav-item">
              <%= link_to "Dashboard", root_path,
                    class: "nav-link #{'active' if current_page?(root_path)}" %>
            </li>
            <li class="nav-item">
              <%= link_to "Tasks", tasks_path,
                    class: "nav-link #{'active' if controller_name == 'tasks'}" %>
            </li>
          </ul>
          <%= link_to "+ New Task", new_task_path, class: "btn btn-primary" %>
        </div>
      </div>
    </nav>

    <main class="container py-4">
      <%# ---------- Flash messages ---------- %>
      <% if notice.present? %>
        <div class="alert alert-success alert-dismissible fade show" role="alert">
          <%= notice %>
          <button type="button" class="btn-close" data-bs-dismiss="alert"
                  aria-label="Close"></button>
        </div>
      <% end %>

      <% if alert.present? %>
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
          <%= alert %>
          <button type="button" class="btn-close" data-bs-dismiss="alert"
                  aria-label="Close"></button>
        </div>
      <% end %>

      <%= yield %>
    </main>

    <footer class="text-center text-body-secondary py-4 small">
      TaskFlow &middot; Built with Ruby on Rails
    </footer>

    <%= javascript_include_tag "bootstrap.bundle.min" %>
  </body>
</html>
